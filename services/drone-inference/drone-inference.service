[Unit]
Description=Drone Inference Service
Requires=drone-sensors.service
Requires=drone-fc.service
After=drone-sensors.service
After=drone-fc.service

[Service]
Type=simple
User=rodion
WorkingDirectory=/home/rodion/drone
EnvironmentFile=/home/rodion/drone/.env
ExecStart=/home/rodion/.pyenv/versions/drone/bin/python services/drone-inference/inference.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
